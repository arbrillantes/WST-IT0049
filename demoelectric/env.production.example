# Copy to .env in the HOSTED project root (beside app/, not inside public/).
# Replace every CHANGE_ME value with the details from your hosting account.
# Keep your local XAMPP configuration separate.
CI_ENVIRONMENT = production

app.baseURL = 'https://CHANGE_ME.example/'
app.forceGlobalSecureRequests = true
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

database.default.hostname = 'CHANGE_ME_database_host'
database.default.database = 'CHANGE_ME_database'
database.default.username = 'CHANGE_ME_database_user'
database.default.password = 'CHANGE_ME_database_password'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.DBDebug = false

# Sessions use this server's writable/session directory by default.
# No Windows path or localhost URL should be added here.
logger.threshold = 4
